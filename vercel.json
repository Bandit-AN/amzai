{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron?continuationRunsRemaining=3",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/storefronts",
      "schedule": "0 19 * * *"
    }
  ],
  "functions": {
    "api/admin.js": { "maxDuration": 10 },
    "api/auth.js": { "maxDuration": 10 },
    "api/cron.js": { "maxDuration": 120 },
    "api/target.js": { "maxDuration": 120 },
    "api/enrich.js": { "maxDuration": 60 },
    "api/analyze.js": { "maxDuration": 60 },
    "api/finalize.js": { "maxDuration": 30 },
    "api/status.js": { "maxDuration": 10 },
    "api/student.js": { "maxDuration": 10 },
    "api/storefronts.js": { "maxDuration": 120 },
    "api/worker.js": { "maxDuration": 30 }
  }
}
